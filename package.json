{
  "name": "@lifesphere/api",
  "version": "0.1.0",
  "description": "LifeSphere backend API and worker",
  "scripts": {
    "build": "nest build",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:worker": "node --env-file-if-exists=.env dist/main.js --role=worker",
    "dev": "node --env-file=.env -r ts-node/register/transpile-only src/main.ts",
    "dev:all": "node --env-file=.env -r ts-node/register/transpile-only src/main.ts --role=both",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env -r ts-node/register/transpile-only src/db/migrate.ts",
    "db:migrate:prod": "node --env-file-if-exists=.env dist/db/migrate.js",
    "db:seed": "node --env-file-if-exists=.env -r ts-node/register/transpile-only src/db/seed.ts",
    "openapi": "node --env-file-if-exists=.env -r ts-node/register/transpile-only scripts/export-openapi.ts && node scripts/endpoint-inventory.js",
    "test": "jest --runInBand",
    "test:e2e": "jest --runInBand test/e2e",
    "setup": "node scripts/setup-env.js",
    "dev:worker": "node --env-file=.env -r ts-node/register/transpile-only src/main.ts --role=worker"
  },
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.4",
    "google-auth-library": "^11.3.1",
    "helmet": "^8.3.0",
    "jose": "^5.10.0",
    "libphonenumber-js": "^1.13.15",
    "multer": "^2.4.0",
    "nestjs-pino": "^5.3.1",
    "otplib": "^12.0.1",
    "pg": "^8.23.1",
    "pg-boss": "^10.4.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rrule": "^2.8.1",
    "rxjs": "^7.8.2",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "jest": "^29.7.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "5.6"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.(spec|e2e)\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.jest.json",
          "diagnostics": false
        }
      ]
    },
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/test/setup-env.ts"
    ],
    "testTimeout": 60000
  }
}
