# ---------------------------------------------------------------------------
# LifeSphere API / worker configuration. Copy to .env and fill in.
# Every value is validated at start-up (src/config/env.ts); bad config fails fast.
# Never commit a real .env.
# ---------------------------------------------------------------------------

NODE_ENV=development            # development | test | production
PORT=4000
PROCESS_ROLE=api                # api | worker | both (both = dev only)
LOG_LEVEL=info
TRUST_PROXY=true
APP_BASE_URL=http://localhost:3008   # web app, used in invite links
API_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3008   # comma-separated

# --- Database (PostgreSQL 15+) ---------------------------------------------
# Neon: DATABASE_URL = pooled endpoint (-pooler), DATABASE_DIRECT_URL = direct endpoint.
# Migrations and the job queue always use the direct URL.
DATABASE_URL=postgres://lifesphere:lifesphere@localhost:5432/lifesphere
DATABASE_DIRECT_URL=postgres://lifesphere:lifesphere@localhost:5432/lifesphere
DATABASE_POOL_MAX=10
DATABASE_SSL=false              # true for Neon / managed Postgres

# --- Secrets (generate fresh values per environment) -------------------------
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HASH_PEPPER=
# 32 bytes base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
WEBHOOK_SECRET=change-me-webhook-secret

ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30

# --- OTP --------------------------------------------------------------------
OTP_TTL_SEC=300
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_DESTINATION_HOUR=5
OTP_MAX_PER_IP_HOUR=30
OTP_DEV_ECHO=true               # dev only: returns the code in the API response. Refused in production.
# OTP_DEV_FIXED_CODE=123456     # dev only. Refused in production.

# --- Safety & sharing ------------------------------------------------------
JOBS_TIMEZONE=UTC              # daily background jobs run at 08:00 / 02:30 in this zone (Asia/Kolkata for India-first)
GRANT_COOLOFF_MINUTES=10        # new sharing grants take effect after this delay
STAFF_REQUIRE_MFA=true

# --- SMS -------------------------------------------------------------------
# mock | msg91 (India, DLT templates) | twilio (worldwide) | routed (+91 via MSG91, rest via Twilio)
SMS_PROVIDER=mock
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_OTP_TEMPLATE_ID=          # template variable: ##otp##
MSG91_ALERT_TEMPLATE_ID=        # template variable: ##var1##
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                    # a Twilio number, or use TWILIO_MESSAGING_SERVICE_SID
TWILIO_MESSAGING_SERVICE_SID=

# --- Email ----------------------------------------------------------------
EMAIL_PROVIDER=mock             # mock | resend  (Render free tier blocks outbound mail)
RESEND_API_KEY=
EMAIL_FROM=LifeSphere <no-reply@lifesphere.local>

# --- Push -----------------------------------------------------------------
PUSH_PROVIDER=mock              # mock | fcm (Android/iOS app, later)
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=       # single-line JSON
# Web Push for the web app: npx web-push generate-vapid-keys
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_SUBJECT=mailto:privacy@lifesphere.local

# --- File storage -----------------------------------------------------------
STORAGE_PROVIDER=local          # local | s3 (Cloudflare R2 / S3 / MinIO)
STORAGE_LOCAL_DIR=./.storage
S3_ENDPOINT=                    # e.g. https://<account>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
UPLOAD_MAX_BYTES=5242880

# --- AI assistant -------------------------------------------------------------
AI_PROVIDER=mock                # mock | anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
EMBEDDINGS_PROVIDER=none        # none (full-text search) | openai (needs pgvector)
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_DIMENSIONS=1536

# --- Email agent: connect Gmail / Outlook --------------------------------
# Only "read" and "send" permissions are requested. Leave empty to hide that provider.
# Gmail: Google Cloud console -> OAuth client (Web). Redirect URI: <API_BASE_URL>/v1/mail/oauth/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Outlook: Microsoft Entra -> App registration. Redirect URI: <API_BASE_URL>/v1/mail/oauth/outlook/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MAIL_DEMO_ENABLED=true          # sample mailbox for trying agents; defaults to off in production

# --- Documents ---------------------------------------------------------------
DOCUMENT_MAX_BYTES=20971520     # 20 MB per file
DOCUMENT_TEXT_MAX_CHARS=200000  # text an agent can read per file
AGENT_RUN_RETENTION_DAYS=90     # agent activity log

# --- Retention (days) ----------------------------------------------------------
PRIVACY_REQUEST_SLA_DAYS=30
ACCOUNT_DELETION_GRACE_DAYS=7
SOFT_DELETE_PURGE_DAYS=30
AUDIT_RETENTION_DAYS=365
EVIDENCE_RETENTION_DAYS=180
AI_HISTORY_RETENTION_DAYS=30

# --- Ops ------------------------------------------------------------------
WORKER_HEARTBEAT_URL=           # e.g. healthchecks.io ping URL; pages you if the worker stops
RATE_LIMIT_PER_MINUTE=120
THROTTLE_DISABLED=false         # tests only; refused in production
